# Example configuration file for Excel AI
# Copy to .env or use EXAI_ENV_FILE=config/dell.env / config/yoga.env

EXAI_MACHINE_NAME=dell-g15
EXAI_LLM_BASE_URL=http://127.0.0.1:8080/v1
EXAI_LLM_MODEL=qwen2.5-coder-7b-instruct-q4_k_m
EXAI_LLM_TEMPERATURE=0.0
EXAI_LLM_MAX_TOKENS=512
EXAI_LLM_TIMEOUT_S=120
EXAI_LLM_EXTRA_BODY={}

EXAI_BACKEND_HOST=127.0.0.1
EXAI_BACKEND_PORT=8000
EXAI_DATA_DIR=data
EXAI_MAX_RETRIES=2
EXAI_MAX_PROMPT_ROWS=30

